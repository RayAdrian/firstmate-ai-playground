{
  "name": "firstmate-ai-playground",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "seed": "tsx --env-file-if-exists=${FM_ENV_FILE:-.env.local} scripts/seed/index.ts",
    "db:local-roles": "tsx --env-file-if-exists=${FM_ENV_FILE:-.env.local} scripts/db/local-roles.ts",
    "db:reset:test": "tsx --env-file-if-exists=${FM_ENV_FILE:-.env.local} scripts/seed/reset-test.ts",
    "news:run": "tsx --env-file-if-exists=${FM_ENV_FILE:-.env.local} scripts/news/run.ts",
    "news:import": "tsx --env-file-if-exists=${FM_ENV_FILE:-.env.local} scripts/news/import.ts",
    "news:rescore": "tsx --env-file-if-exists=${FM_ENV_FILE:-.env.local} scripts/news/rescore.ts",
    "news:schedule:install": "bash ops/launchd/install.sh",
    "news:schedule:uninstall": "bash ops/launchd/uninstall.sh",
    "news:sources:check": "tsx scripts/news/check-sources.ts",
    "exercises:verify": "tsx scripts/exercises/verify.ts",
    "content:stale": "tsx scripts/seed/stale.ts",
    "gate:merge": "bash scripts/gate-merge.sh",
    "workflows:validate": "tsx scripts/workflows/validate.ts",
    "workflows:scan": "tsx scripts/workflows/scan.ts",
    "workflows:share": "tsx scripts/workflows/share.ts",
    "media:render": "npm --prefix media/remotion run render --",
    "media:record": "bash media/tapes/record.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "fast-xml-parser": "^5.11.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.48.0",
    "next": "16.3.7",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
