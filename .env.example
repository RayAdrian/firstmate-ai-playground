# Copy to .env.local and fill from `supabase status -o env` (local stack, ports 544xx).
# .env.local ALWAYS points at the LOCAL stack: dev, tests and agents read it. Never put hosted keys in it.
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_ANON_KEY=
# Service role: scripts only (seed, news pipeline). Never import from src/app.
SUPABASE_SERVICE_ROLE_KEY=
# Community writes (PRD 18.4): direct Postgres connection as the community_writer role, server-only.
# Local value; its login is set by `npm run db:local-roles` and supabase/seed.sql. Hosted: set it only as the Vercel
# server env var, built from the generated login secret (pooled, port 6543). Never prefix it with NEXT_PUBLIC_.
COMMUNITY_DATABASE_URL=postgresql://community_writer:community_writer_local_only@127.0.0.1:54422/postgres

# Hosted project (scripts only): keep these in .env.hosted.local (gitignored), never here, and run e.g.
#   FM_ENV_FILE=.env.hosted.local npm run seed
# Scripts print their target host on start. `db:reset:test` and `db:local-roles` refuse a non-local database.
# .env.hosted.local holds SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY for the hosted project.
