{
  "task": "Add a slugify(input) function in src/slug.js with a test. Touch only src/, tests/ and docs/. Keep the change under 80 changed lines.",
  "threshold": 0.8,
  "cases": [
    {
      "id": "good-slugify",
      "checks": [
        {
          "type": "file_exists",
          "path": "src/slug.js"
        },
        {
          "type": "file_contains",
          "path": "src/slug.js",
          "pattern": "export function slugify"
        },
        {
          "type": "file_not_contains",
          "path": "src/slug.js",
          "pattern": "console\\.log"
        },
        {
          "type": "diff_touches_only",
          "diff": "patch.diff",
          "allow": [
            "src/**",
            "tests/**",
            "docs/**"
          ]
        },
        {
          "type": "max_diff_lines",
          "diff": "patch.diff",
          "max": 80
        }
      ]
    },
