@@ -0,0 +1,7 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { slugify } from "../src/slug.js";
+
+test("slugify", () => {
+  assert.equal(slugify("Hello, World!"), "hello-world");
+});
